const express=require('express');
const path=require('path');
const https=require('https');
const app=express();
const PORT=process.env.PORT||10000;
const TOKEN=process.env.METAAPI_TOKEN||'';
const ACCOUNT=process.env.METAAPI_ACCOUNT_ID||'93f7b19b-d414-4302-bec7-86f6bf59a7ea';

app.use(express.static(path.join(__dirname,'public')));
app.use(express.json());

function metaFetch(url){
 return new Promise((resolve,reject)=>{
   const u=new URL(url);
   const opts={hostname:u.hostname,path:u.pathname+u.search,method:'GET',headers:{'auth-token':TOKEN}};
   const req=https.request(opts,res=>{
     let d=''; res.on('data',c=>d+=c); res.on('end',()=>resolve({ok:res.statusCode<400,status:res.statusCode,txt:d,json:()=>{try{return JSON.parse(d)}catch{return {raw:d}}}}));
   });
   req.on('error',reject); req.end();
 });
}

app.get('/api/bot',async(req,res)=>{
 try{
   if(!TOKEN) return res.json({error:'NO_TOKEN',balance:20,tokenLen:0,tokenSet:false});
   const base=`https://mt-client-api-v1.new-york.agiliumtrade.ai`;
   let accountInfo={balance:20}, candles=[], signal='WAITING', reasons=[];
   try{
     const r=await metaFetch(`${base}/users/current/accounts/${ACCOUNT}/account-information`);
     if(r.ok){ const j=r.json(); accountInfo={balance:j.balance||20,equity:j.equity,profit:j.profit}; }
   }catch(e){ reasons.push('acct fail: '+e.message); }
   try{
     const r=await metaFetch(`${base}/users/current/accounts/${ACCOUNT}/symbols/XAUUSD/current-price`);
     const j=r.json();
     candles=[{close:j.bid||j.price||2650,time:Date.now()}];
   }catch(e){ reasons.push('price fail: '+e.message); }
   // fake EMAs for now so chart loads
   const closes=candles.map(c=>c.close);
   const last=closes[0]||2650;
   const ema9=last, ema21=last-2, ema50=last-5;
   signal=ema9>ema21 && ema21>ema50?'BUY':'SELL';
   res.json({balance:accountInfo.balance,equity:accountInfo.equity,profit:accountInfo.profit,signal,ema:{ema9,ema21,ema50},candles:[{time:Date.now()-60000*4,close:last-3},{time:Date.now()-60000*3,close:last-2},{time:Date.now()-60000*2,close:last-1},{time:Date.now()-60000,close:last}],price:last,tokenLen:TOKEN.length,tokenSet:true,accountId:ACCOUNT,reasons,mode:'REAL_TOKEN'});
 }catch(e){ res.status(500).json({error:e.message,balance:20,tokenLen:TOKEN.length}); }
});

app.get('*',(req,res)=>res.sendFile(path.join(__dirname,'public','index.html')));
app.listen(PORT,()=>console.log('SR-72 REAL TOKEN LEN',TOKEN.length,'on',PORT));
