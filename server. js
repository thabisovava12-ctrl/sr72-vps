app.post('/api/scan_image', upload.single('image'), (req,res)=>{
  const symbol = req.body.symbol || state.symbol;
  const p = state.price;
  const e9 = state.ema[9], e21 = state.ema[21], e50 = state.ema[50];

  // FIX 1: Direction = VISION, not EMA
  const dir = state.mtf.img || 'BUY';
  const conf = state.mtf.M1!== state.mtf.img? 74 : 86;
  const isBuy = dir === 'BUY';

  // FIX 2: RR 1:2 STRICT
  const A_SL = 3.5, A_TP = 7.0; // 1:2
  const C_SL = 5.0, C_TP = 10.0; // 1:2

  res.json({
    symbol, live: p, dec: 2, high: state.high, low: state.low,
    period_high: state.period_high, period_low: state.period_low,
    ema9: e9, ema21: e21, ema50: e50, direction: dir, confidence: conf, mtf: state.mtf,
    trend: `${symbol} EMA 9 ${e9.toFixed(2)} 21 ${e21.toFixed(2)} 50 ${e50.toFixed(2)} MTF M1 ${state.mtf.M1} M5 ${state.mtf.M5} M15 ${state.mtf.M15} [VISION ${state.mtf.img} ${conf}.0] PRICE ${p.toFixed(2)} RR 1:2`,
    aggressive: {
      side: dir,
      entry_low: (p-0.2).toFixed(1), entry_high: (p+0.2).toFixed(1), entry_mid: p.toFixed(1),
      sl: (isBuy? p - A_SL : p + A_SL).toFixed(2),
      tp1: (isBuy? p + A_TP : p - A_TP).toFixed(1),
      tp2: (isBuy? p + A_TP : p - A_TP).toFixed(1),
      desc: `SR-72 VISION ${dir} ${p.toFixed(1)} M1 ${state.mtf.M1} M5 ${state.mtf.M5} M15 ${state.mtf.M15} IMG ${state.mtf.img} ${conf}.0 ${conf>=80?'ACTIVE':'LOCKED'} RR 1:2 SL ${A_SL} TP ${A_TP}`
    },
    conservative: {
      side: dir,
      entry_low: '4134.2', entry_high: '4135.9',
      sl: (isBuy? 4135.05 - C_SL : 4135.05 + C_SL).toFixed(1),
      tp1: (isBuy? 4135.05 + C_TP : 4135.05 - C_TP).toFixed(1),
      tp2: (isBuy? 4135.05 + C_TP : 4135.05 - C_TP).toFixed(1),
      desc: `BREAKDOWN ${dir} RR 1:2 SL ${C_SL} TP ${C_TP}`
    }
  });
});
