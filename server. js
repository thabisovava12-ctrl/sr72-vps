const express = require('express');
const multer = require('multer');
const app = express();
app.use(express.json());
app.use(express.static('public'));
const upload = multer({storage: multer.memoryStorage()});

let state = {
  symbol: 'XAUUSDc', price: 4190.84, high: 4193.31, low: 4184.30,
  period_high: 4193.31, period_low: 4184.30,
  ema: {9:4189.07,21:4188.54,50:4188.90},
  mtf: {M1:'SELL',M5:'SELL',M15:'SELL',img:'SELL'},
  positions: [], orders: [], lastTick: Date.now()
};
function emaUpd(pr, prev, per){ const k=2/(per+1); return pr*k+prev*(1-k); }

app.post('/api/tick',(req,res)=>{
  const {price,symbol,high,low}=req.body;
  if(!price) return res.json({ok:false});
  state.price=parseFloat(price);
  if(symbol) state.symbol=symbol;
  if(high) state.high=parseFloat(high);
  if(low) state.low=parseFloat(low);
  state.ema[9]=emaUpd(state.price,state.ema[9],9);
  state.ema[21]=emaUpd(state.price,state.ema[21],21);
  state.ema[50]=emaUpd(state.price,state.ema[50],50);
  state.lastTick=Date.now();
  res.json({ok:true});
});

app.get('/api/analyze',(req,res)=>{
  const p=state.price, e9=state.ema[9], e21=state.ema[21], e50=state.ema[50];
  let m1=e9>e21&&e21>e50?'BUY':e9<e21&&e21<e50?'SELL':'RANGE';
  state.mtf.M1=m1;
  let {M5,M15,img}=state.mtf;
  let signal,conf,lock;
  if(m1==='SELL'&&M5==='SELL'&&M15==='SELL'&&img==='SELL'){signal='SELL';conf=86;lock='SELL ACTIVE';}
  else if(m1==='BUY'&&M5==='BUY'&&M15==='BUY'&&img==='BUY'){signal='BUY';conf=86;lock='BUY ACTIVE';}
  else if(m1!==img){signal='LOCKED_WAIT';conf=74;lock=`${img} LOCKED`;}
  else{signal='LOCKED_WAIT';conf=45;lock=`${img} LOCKED`;}
  res.json({symbol:state.symbol, price:p.toFixed(2), live:p.toFixed(2), high:state.high.toFixed(2), low:state.low.toFixed(2), period_high:state.high.toFixed(2), period_low:state.low.toFixed(2), ema9:e9.toFixed(2), ema21:e21.toFixed(2), ema50:e50.toFixed(2), mtf:state.mtf, vision:img, visionLock:lock, signal:signal, confidence:conf+'%', speed:'120ms'});
});

app.post('/api/scan_image', upload.single('image'), (req,res)=>{
  const symbol=req.body.symbol||state.symbol;
  const p=state.price, e9=state.ema[9], e21=state.ema[21], e50=state.ema[50];
  const dir=state.mtf.img;
  const isBuy=dir==='BUY';
  const A_SL=3.5,A_TP=7.0,C_SL=5.0,C_TP=10.0;
  res.json({
    symbol, live:p, dec:2, high:state.high, low:state.low, period_high:state.period_high, period_low:state.period_low,
    ema9:e9, ema21:e21, ema50:e50, direction:dir, confidence:86, mtf:state.mtf,
    trend:`${symbol} EMA 9 ${e9.toFixed(2)} 21 ${e21.toFixed(2)} 50 ${e50.toFixed(2)} MTF M1 ${state.mtf.M1} M5 ${state.mtf.M5} M15 ${state.mtf.M15} [VISION ${state.mtf.img} 180.0] PRICE ${p.toFixed(2)} RR 1:2`,
    aggressive:{
      side:dir, entry_low:(p-0.2).toFixed(1), entry_high:(p+0.2).toFixed(1), entry_mid:p.toFixed(1),
      sl:(isBuy?p-A_SL:p+A_SL).toFixed(2), tp1:(isBuy?p+A_TP:p-A_TP).toFixed(1), tp2:(isBuy?p+A_TP:p-A_TP).toFixed(1),
      desc:`SR-72 VISION ${dir} ${p.toFixed(1)} RR 1:2 SL ${A_SL} TP ${A_TP} ${state.mtf.M1}/${state.mtf.M5}/${state.mtf.M15} ACTIVE`
    },
    conservative:{
      side:dir, entry_low:(p-16.8).toFixed(1), entry_high:(p-15.2).toFixed(1),
      sl:(isBuy?(p-16)-C_SL:(p-16)+C_SL).toFixed(1), tp1:(isBuy?(p-16)+C_TP:(p-16)-C_TP).toFixed(1), tp2:(isBuy?(p-16)+C_TP:(p-16)-C_TP).toFixed(1),
      desc:`BREAKDOWN ${dir} RR 1:2 SL ${C_SL} TP ${C_TP}`
    }
  });
});

app.get('/api/positions',(req,res)=>res.json(state.positions));
app.get('/api/orders',(req,res)=>res.json(state.orders));
app.post('/api/sniper/enter',(req,res)=>{ state.positions.push(req.body.plan); res.json({ok:true}); });
app.post('/api/close_all',(req,res)=>{ state.positions=[]; res.json({ok:true}); });
app.listen(process.env.PORT||10000);
