app.post('/api/scan_image', upload.single('image'), (req,res)=>{
  const symbol = req.body.symbol || state.symbol;
  const p = state.price;
  const e9 = state.ema[9], e21 = state.ema[21], e50 = state.ema[50];
  const dir = e9 < e21? 'SELL' : 'BUY';
  const conf = state.mtf.M1!== state.mtf.img? 74 : 86;
  const isBuy = dir==='BUY';

  // RISK REWARD 1:2 FIXED
  const aggSL = 3.5;
  const aggTP = aggSL * 2; // 7.0 = 1:2
  const consSL = 5.0;
  const consTP = consSL * 2; // 10.0 = 1:2

  res.json({
    symbol: symbol, live: p, dec: 2, high: state.high, low: state.low,
    period_high: state.period_high, period_low: state.period_low,
    ema9: e9, ema21: e21, ema50: e50, direction: dir, confidence: conf, mtf: state.mtf,
    trend: `${symbol} EMA 9 ${e9.toFixed(2)} 21 ${e21.toFixed(2)} 50 ${e50.toFixed(2)} MTF M1 ${state.mtf.M1} M5 ${state.mtf.M5} M15 ${state.mtf.M15} [VISION ${state.mtf.img}] Price ${p.toFixed(2)} RR 1:2`,
    aggressive: {
      side: dir, entry_low: (p-0.5).toFixed(2), entry_high: (p+0.5).toFixed(2), entry_mid: p.toFixed(2),
      sl: (isBuy?p-aggSL:p+aggSL).toFixed(2),
      tp1: (isBuy?p+aggTP:p-aggTP).toFixed(2),
      tp2: (isBuy?p+aggTP:p-aggTP).toFixed(2),
      desc: `EMA 9/21/50 ${dir} • Vision ${state.mtf.img} ${conf}% • RR 1:2 • SL ${aggSL} TP ${aggTP} • H ${state.high.toFixed(2)} L ${state.low.toFixed(2)}`
    },
    conservative: {
      side: dir, entry_low: (isBuy?p+1:p-3).toFixed(2), entry_high: (isBuy?p+3:p-1).toFixed(2),
      sl: (isBuy?p-consSL:p+consSL).toFixed(2),
      tp1: (isBuy?p+consTP:p-consTP).toFixed(2),
      tp2: (isBuy?p+consTP:p-consTP).toFixed(2),
      desc: `Breakout • ${symbol} • RR 1:2 • SL ${consSL} TP ${consTP} • EMA 50 ${e50.toFixed(2)} • H/L ${state.high.toFixed(2)}/${state.low.toFixed(2)}`
    }
  });
});
