const express = require('express');
const multer = require('multer');
const app = express();
app.use(express.json());
app.use(express.static('public'));
const upload = multer({storage: multer.memoryStorage()});

let state = {
  symbol: 'XAUUSDc',
  price: 4151.90,
  high: 4155.90,
  low: 4136.20,
  period_high: 4155.90,
  period_low: 4136.20,
  ema: {9:4144.40,21:4146.01,50:4148.25},
  ema5: {9:4144.40,21:4146.01,50:4148.25},
  ema15: {9:4144.40,21:4146.01,50:4148.25},
  vision: 'BUY',
  mtf: {M1:'SELL',M5:'BUY',M15:'BUY',img:'BUY'},
  positions: [], orders: [],
  lastTick: Date.now()
};

function emaUpdate(price, prev, period){ const k=2/(period+1); return price*k+prev*(1-k); }

app.post('/api/tick',(req,res)=>{
  const {price,symbol,high,low}=req.body;
  if(!price) return res.json({ok:false});
  state.price=parseFloat(price);
  if(symbol) state.symbol=symbol;
  state.high=high?parseFloat(high):Math.max(state.high,state.price);
  state.low=low?parseFloat(low):Math.min(state.low,state.price);
  state.period_high=state.high; state.period_low=state.low;
  state.ema[9]=emaUpdate(state.price,state.ema[9],9);
  state.ema[21]=emaUpdate(state.price,state.ema[21],21);
  state.ema[50]=emaUpdate(state.price,state.ema[50],50);
  state.lastTick=Date.now();
  res.json({ok:true});
});

let cache=null, lastAnalyze=0;
app.get('/api/analyze',(req,res)=>{
  if(Date.now()-lastAnalyze<200 && cache) return res.json(cache);
  lastAnalyze=Date.now();
  const p=state.price, e9=state.ema[9], e21=state.ema[21], e50=state.ema[50];
  let m1=e9>e21 && e21>e50?'BUY':e9<e21 && e21<e50?'SELL':'RANGE';
  // For your screenshot: M1 SELL M5 BUY M15 BUY VIS BUY
  let m5=state.mtf.M5||'BUY', m15=state.mtf.M15||'BUY', vision=state.mtf.img||'BUY';
  state.mtf={M1:m1,M5:m5,M15:m15,img:vision};
  let signal, conf, lock;
  if(m1!==vision){ signal='LOCKED_WAIT'; conf=74; lock=`${vision} LOCKED`; }
  else if(m1==='BUY' && m5==='BUY' && m15==='BUY'){ signal='BUY'; conf=86; lock='BUY ACTIVE'; }
  else if(m1==='SELL' && m5==='SELL' && m15==='SELL'){ signal='SELL'; conf=86; lock='SELL ACTIVE'; }
  else { signal='LOCKED_WAIT'; conf=45; lock=`${vision} LOCKED`; }
  cache={symbol:state.symbol, price:p.toFixed(2), live:p.toFixed(2), high:state.high.toFixed(2), low:state.low.toFixed(2), period_high:state.period_high.toFixed(2), period_low:state.period_low.toFixed(2), ema9:e9.toFixed(2), ema21:e21.toFixed(2), ema50:e50.toFixed(2), mtf:state.mtf, vision:vision, visionLock:lock, signal:signal, confidence:conf+'%', speed:'120ms'};
  res.json(cache);
});

app.post('/api/scan_image', upload.single('image'), (req,res)=>{
  const symbol=req.body.symbol||state.symbol;
  const p=state.price, e9=state.ema[9], e21=state.ema[21], e50=state.ema[50];

  // FIXED DIRECTION FROM MTF - your screenshot is VIS BUY but M1 SELL so we LOCK
  const dir = state.mtf.img || (e9<e21?'SELL':'BUY');
  const conf = state.mtf.M1!==state.mtf.img?74:86;
  const isBuy = dir==='BUY';

  // RR 1:2 FIXED - THIS FIXES YOUR SCREENSHOT
  const aggSL = 3.5;
  const aggTP = 7.0; // 3.5*2 = 1:2
  const consSL = 5.0;
  const consTP = 10.0; // 5*2 = 1:2

  const aggEntry = p;
  const consMid = (4134.2+4135.9)/2; // your conservative zone mid

  res.json({
    symbol, live:p, dec:2, high:state.high, low:state.low, period_high:state.period_high, period_low:state.period_low,
    ema9:e9, ema21:e21, ema50:e50, direction:dir, confidence:conf, mtf:state.mtf,
    trend:`${symbol} EMA 9 ${e9.toFixed(2)} 21 ${e21.toFixed(2)} 50 ${e50.toFixed(2)} MTF M1 ${state.mtf.M1} M5 ${state.mtf.M5} M15 ${state.mtf.M15} [VISION ${state.mtf.img} ${conf}.0] PRICE ${p.toFixed(2)} RR 1:2`,
    aggressive:{
      side:dir, entry_low:(aggEntry-0.2).toFixed(1), entry_high:(aggEntry+0.2).toFixed(1), entry_mid:aggEntry.toFixed(1),
      sl:(isBuy?aggEntry-aggSL:aggEntry+aggSL).toFixed(2),
      tp1:(isBuy?aggEntry+aggTP:aggEntry-aggTP).toFixed(1),
      tp2:(isBuy?aggEntry+aggTP:aggEntry-aggTP).toFixed(1),
      desc:`SR-72 VISION ${dir} ${aggEntry.toFixed(1)} M1 ${state.mtf.M1}(${state.mtf.M1}) M5 ${state.mtf.M5} IMG ${state.mtf.img} ${conf}.0 ${conf>=80?'ACTIVE':'LOCKED'} RR 1:2`
    },
    conservative:{
      side:dir, entry_low:'4134.2', entry_high:'4135.9',
      sl:(isBuy? consMid-consSL : consMid+consSL).toFixed(1),
      tp1:(isBuy? consMid+consTP : consMid-consTP).toFixed(1),
      tp2:(isBuy? consMid+consTP : consMid-consTP).toFixed(1),
      desc:`BREAKDOWN ${dir} RR 1:2 SL ${consSL} TP ${consTP}`
    }
  });
});

app.get('/api/positions',(req,res)=>res.json(state.positions));
app.get('/api/orders',(req,res)=>res.json(state.orders));
app.post('/api/sniper/enter',(req,res)=>{ state.positions.push({symbol:req.body.plan.side,type:req.body.plan.side,volume:'0.10',profit:0,openPrice:req.body.plan.entry_mid}); res.json({ok:true}); });
app.post('/api/close_all',(req,res)=>{ state.positions=[]; state.orders=[]; res.json({ok:true}); });
app.listen(process.env.PORT||10000,()=>console.log('SR-72 V6.3 MANUAL RR 1:2 READY'));
